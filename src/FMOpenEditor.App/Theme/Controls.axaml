<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================ Typography ============================ -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="44" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-1.6" />
    <Setter Property="LineHeight" Value="46" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.7" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.1" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.6" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
  </Style>
  <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.num, SelectableTextBlock.num">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <!-- Gradient headline word -->
  <Style Selector="TextBlock.chroma">
    <Setter Property="Foreground" Value="{DynamicResource ChromaBrush}" />
  </Style>

  <!-- ============================== Glass ============================== -->
  <Style Selector="Border.card, Border.glass">
    <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="BoxShadow" Value="{DynamicResource GlassShadow}" />
  </Style>
  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{DynamicResource GlassBarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="{DynamicResource GlassShadow}" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource GlassInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <!-- Cards that respond to the pointer: lift, brighten the edge -->
  <Style Selector="Border.lift">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.lift:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-4px)" />
    <Setter Property="BoxShadow" Value="{DynamicResource GlassShadowHover}" />
  </Style>

  <!-- Small rounded tile that holds an icon -->
  <Style Selector="Border.tile">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ChromaBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnChromaBrush}" />
  </Style>
  <Style Selector="Border.tile.warm">
    <Setter Property="Background" Value="{DynamicResource SunsetBrush}" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FieldEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.pill.pending">
    <Setter Property="Background" Value="{DynamicResource SunsetBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="TextElement.Foreground" Value="#2A0E00" />
    <Setter Property="BoxShadow" Value="{DynamicResource WarmGlowShadow}" />
  </Style>

  <!-- ============================== Buttons ============================== -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed, ToggleButton:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <!-- Primary: the Chroma gradient with a glow -->
  <Style Selector="Button.accent">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChromaBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnChromaBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource GlowShadow}" />
  </Style>
  <Style Selector="Button.accent:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px) scale(1.02)" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChromaHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnChromaBrush}" />
  </Style>
  <Style Selector="Button.accent:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChromaBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnChromaBrush}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- Large call-to-action -->
  <Style Selector="Button.hero">
    <Setter Property="Padding" Value="22,13" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <!-- Quiet: no chrome until hovered -->
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Inline text link -->
  <Style Selector="Button.link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter, Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- Square icon button -->
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover, ToggleButton.icon:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.08)" />
  </Style>

  <!-- Preset chips -->
  <Style Selector="Button.preset, Button.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="13,5" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.preset:pointerover, Button.chip:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>

  <!-- ============================== Inputs ============================== -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectedBrush}" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <Style Selector="ComboBox, NumericUpDown, CalendarDatePicker">
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="4,1" />
  </Style>

  <!-- ============================== Navigation ============================== -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Margin" Value="8,1" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <!-- The highlight lives on the row, not the whole item, so a section heading above it stays plain. -->
  <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ListBox.nav Border.navrow">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover Border.navrow">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Border.navrow">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
  </Style>
  <!-- The marker that slides in beside the selected page -->
  <Style Selector="ListBox.nav Border.pip">
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource ChromaBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Height" Duration="0:0:0.22" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Border.pip">
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="ListBox.nav Panel.navicon">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="BackEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover Panel.navicon">
    <Setter Property="RenderTransform" Value="scale(1.18) rotate(-6deg)" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Panel.navicon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Dense lists (Research) -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource GlassInsetBrush}" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- ============================== Tabs ============================== -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource ChromaBrush}" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <!-- ============================== Data grid ============================== -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="RowHeight" Value="40" />
    <Setter Property="ColumnHeaderHeight" Value="36" />
  </Style>
  <!-- The stock header keeps ~32px free for a sort icon on every column, which made two-digit
       columns like Age wide. This one is just the label; the sorted column carries an arrow in its text. -->
  <Styles.Resources>
    <ControlTheme x:Key="CompactColumnHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="12,0,6,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="DataGrid">
    <Setter Property="ColumnHeaderTheme" Value="{StaticResource CompactColumnHeader}" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="SeparatorBrush" Value="Transparent" />
  </Style>
  <Style Selector="DataGridColumnHeader:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="DataGridRow /template/ Rectangle#BackgroundRectangle">
    <Setter Property="RadiusX" Value="10" />
    <Setter Property="RadiusY" Value="10" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridCell /template/ Grid#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Pictures inside rows grow a touch when the row is hovered -->
  <Style Selector="DataGridRow Border.avatar">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="BackEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="DataGridRow:pointerover Border.avatar">
    <Setter Property="RenderTransform" Value="scale(1.22)" />
  </Style>

  <!-- ============================== Overlays ============================== -->
  <Style Selector="ToolTip">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="FlyoutPresenter, MenuFlyoutPresenter, ContextMenu">
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- ============================== Loading ============================== -->
  <Style Selector="Arc.spinner">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="StartAngle" Value="0" />
    <Setter Property="SweepAngle" Value="270" />
    <Setter Property="StrokeThickness" Value="2.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource ChromaBrush}" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>
  <Style Selector="Arc.spinner.spin">
    <Style.Animations>
      <Animation Duration="0:0:0.85" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The live "connected" beacon -->
  <Style Selector="Ellipse.beacon.pulse">
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.7" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="2.8" />
          <Setter Property="ScaleTransform.ScaleY" Value="2.8" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Skeleton shimmer used while pictures are being indexed -->
  <Style Selector="Border.shimmer.run">
    <Style.Animations>
      <Animation Duration="0:0:1.3" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
