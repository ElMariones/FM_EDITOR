<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FMOpenEditor.App.ViewModels"
        xmlns:views="using:FMOpenEditor.App.Views"
        x:Class="FMOpenEditor.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FM OpenEditor"
        Width="1440" Height="880" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:MainWindowViewModel"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:BrowserViewModel"><views:BrowserView /></DataTemplate>
    <DataTemplate DataType="vm:WatchListViewModel"><views:WatchListView /></DataTemplate>
    <DataTemplate DataType="vm:ResearchViewModel"><views:ResearchView /></DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="200,*">

    <!-- Top bar -->
    <Border Grid.ColumnSpan="2" Background="{StaticResource SidebarBrush}" Padding="14,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="FM OpenEditor" Classes="h2" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="{Binding AppVersion}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" IsVisible="{Binding IsConnected}" />
          <TextBlock Text="{Binding ConnectionLabel}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsConnected}">
          <Button Content="⟳ Re-read" Command="{Binding RefreshCommand}" ToolTip.Tip="Re-read the game's lists (new players, transfers)" />
          <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sidebar -->
    <Border Grid.Row="1" Background="{StaticResource SidebarBrush}">
      <ListBox Classes="nav" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" Background="Transparent" Margin="0,8">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NavItem">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Icon}" Width="20" />
              <TextBlock Text="{Binding Title}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Margin="12" />

    <!-- Bottom bar: pending changes -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SidebarBrush}" Padding="14,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConnected}">
          <CheckBox Content="Save instantly" IsChecked="{Binding AutoSave}"
                    ToolTip.Tip="Write every edit to the game as you make it, instead of collecting them for Save changes" />
          <TextBlock VerticalAlignment="Center" Foreground="{StaticResource PendingBrush}"
                     IsVisible="{Binding HasPending}" Text="{Binding PendingCount, StringFormat='{}{0} pending'}" />
          <Button Content="Discard" Command="{Binding DiscardCommand}" IsEnabled="{Binding HasPending}" />
          <Button Content="↶ Undo last save" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
          <Button Classes="accent" Content="Save changes" Command="{Binding SaveCommand}" IsEnabled="{Binding HasPending}"
                  HotKey="Ctrl+S" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
