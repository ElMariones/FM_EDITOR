<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FMOpenEditor.App.ViewModels"
             xmlns:c="using:FMOpenEditor.App.Controls"
             x:Class="FMOpenEditor.App.Views.HomeView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="1060" Spacing="22" Margin="24,28,24,24" HorizontalAlignment="Center">

      <!-- Hero: the pitch, and Tiki watching you -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="16" VerticalAlignment="Center" Margin="0,0,32,0">
          <Border Classes="pill" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <c:Icon Kind="sparkle" Size="13" TextElement.Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Free and open source, forever" FontSize="12" FontWeight="Medium" />
            </StackPanel>
          </Border>

          <StackPanel>
            <TextBlock Classes="display" Text="Your save," />
            <TextBlock Classes="display chroma" Text="your rules." />
          </StackPanel>

          <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="15" LineHeight="23" MaxWidth="520" HorizontalAlignment="Left"
                     Text="FM OpenEditor reads Football Manager while you play. Browse every player, staff member, club and competition, change what you like, and save it straight into the running game." />

          <StackPanel x:Name="TourConnect" Orientation="Horizontal" Spacing="10" Margin="0,4,0,0" HorizontalAlignment="Left">
            <Button Classes="accent hero" Command="{Binding ConnectGameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:Icon Kind="link" Size="17" />
                <TextBlock Text="Connect to Football Manager" />
              </StackPanel>
            </Button>
            <Button Classes="hero" Command="{Binding OpenDemoCommand}"
                    ToolTip.Tip="A generated, fictional database. Everything works, nothing touches the game.">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:Icon Kind="play" Size="15" />
                <TextBlock Text="Try the demo save" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Classes="muted" FontSize="12.5" Text="Start Football Manager and load your save first, then connect." />
        </StackPanel>

        <!-- Tiki on a glass disc -->
        <Panel Grid.Column="1" Width="330" Height="330" x:Name="HeroArt">
          <Ellipse Fill="{DynamicResource GlassBrush}" Stroke="{DynamicResource GlassEdgeBrush}" StrokeThickness="1" />
          <Ellipse Margin="34" Stroke="{DynamicResource HairlineBrush}" StrokeThickness="1" StrokeDashArray="2,6" />
          <c:Mascot Width="232" Height="232" />
        </Panel>
      </Grid>

      <!-- Anything the connection attempt had to say -->
      <Border Classes="glass" Padding="16,14"
              IsVisible="{Binding ConnectMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*">
          <Border Classes="tile warm" VerticalAlignment="Top" Margin="0,0,14,0">
            <c:Icon Kind="bolt" Size="18" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding ConnectMessage}" TextWrapping="Wrap" FontWeight="Medium" />
            <ItemsControl ItemsSource="{Binding ConnectDetails}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Classes="muted" TextWrapping="Wrap" FontSize="12.5" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <!-- What it does -->
      <UniformGrid Columns="4" x:Name="Features">
        <Panel><Border Classes="glass lift" Margin="0,0,12,0">
          <StackPanel Spacing="10">
            <Border Classes="tile" HorizontalAlignment="Left"><c:Icon Kind="bolt" Size="19" /></Border>
            <TextBlock Classes="h2" Text="One-click presets" />
            <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                       Text="Heal, Inspire, Remove bans, Make WonderKid, Rich owner, Top facilities. Write your own as JSON and share them." />
          </StackPanel>
        </Border></Panel>
        <Panel><Border Classes="glass lift" Margin="4,0,8,0">
          <StackPanel Spacing="10">
            <Border Classes="tile" HorizontalAlignment="Left"><c:Icon Kind="edit" Size="19" /></Border>
            <TextBlock Classes="h2" Text="Edit anything" />
            <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                       Text="Names, nationality, attributes, positions, contracts, wages, reputation, finances, facilities, standings and nation rules." />
          </StackPanel>
        </Border></Panel>
        <Panel><Border Classes="glass lift" Margin="8,0,4,0">
          <StackPanel Spacing="10">
            <Border Classes="tile" HorizontalAlignment="Left"><c:Icon Kind="filter" Size="19" /></Border>
            <TextBlock Classes="h2" Text="Search and mass edit" />
            <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                       Text="Filter by any field, then change a whole squad or search result at once. Compare two players side by side." />
          </StackPanel>
        </Border></Panel>
        <Panel><Border Classes="glass lift" Margin="12,0,0,0">
          <StackPanel Spacing="10">
            <Border Classes="tile" HorizontalAlignment="Left"><c:Icon Kind="snow" Size="19" /></Border>
            <TextBlock Classes="h2" Text="Freeze or only-up" />
            <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                       Text="Lock a player's attributes, or let them improve but never decline, while the game runs." />
          </StackPanel>
        </Border></Panel>
      </UniformGrid>

      <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="11.5" HorizontalAlignment="Center" TextAlignment="Center"
                 Text="Back up your save before editing. FM OpenEditor is a fan project, not affiliated with Sports Interactive or SEGA. Licensed under GPL-3.0." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
