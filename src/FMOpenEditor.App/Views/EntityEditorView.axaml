<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FMOpenEditor.App.ViewModels"
             xmlns:c="using:FMOpenEditor.App.Controls"
             x:Class="FMOpenEditor.App.Views.EntityEditorView"
             x:DataType="vm:EntityEditorViewModel">

  <UserControl.Styles>
    <Style Selector="ItemsControl > ContentPresenter">
      <Setter Property="Margin" Value="0,3,10,3" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.label.pending">
      <Setter Property="Foreground" Value="{DynamicResource PendingBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.round"><Setter Property="CornerRadius" Value="42" /></Style>
    <Style Selector="Border.badge"><Setter Property="CornerRadius" Value="18" /><Setter Property="Padding" Value="10" /></Style>
    <Style Selector="Image.fill"><Setter Property="Stretch" Value="UniformToFill" /></Style>
    <Style Selector="Image.fit"><Setter Property="Stretch" Value="Uniform" /></Style>
    <!-- Related lists: the row button is the whole item, so the list item itself stays plain. -->
    <Style Selector="ListBox.related ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBox.related ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.related">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:NumberEditorViewModel">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="label" Classes.pending="{Binding IsPending}" Text="{Binding Label}" Width="{Binding LabelWidth}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <NumericUpDown Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                         Increment="{Binding Increment}" FormatString="{Binding FormatString}"
                         IsEnabled="{Binding IsEditable}" Width="{Binding EditorWidth}" ClipValueToMinMax="True" />
          <TextBlock Text="{Binding MoneyText}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsMoney}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="error" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:BoolEditorViewModel">
      <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="label" Classes.pending="{Binding IsPending}" Text="{Binding Label}" Width="{Binding LabelWidth}" />
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEditable}"
                      OnContent="Yes" OffContent="No" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:TextEditorViewModel">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="label" Classes.pending="{Binding IsPending}" Text="{Binding Label}" Width="{Binding LabelWidth}" />
        <TextBox Grid.Column="1" Text="{Binding Text}" IsEnabled="{Binding IsEditable}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="error" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:DateEditorViewModel">
      <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="label" Classes.pending="{Binding IsPending}" Text="{Binding Label}" Width="{Binding LabelWidth}" />
        <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding Date}" IsEnabled="{Binding IsEditable}"
                            SelectedDateFormat="Custom" CustomDateFormatString="dd MMM yyyy" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:ChoiceEditorViewModel">
      <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="label" Classes.pending="{Binding IsPending}" Text="{Binding Label}" Width="{Binding LabelWidth}" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedIndex="{Binding SelectedIndex}"
                  IsEnabled="{Binding IsEditable}" HorizontalAlignment="Stretch" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:ReferenceEditorViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="label" Classes.pending="{Binding IsPending}" Text="{Binding Label}" Width="{Binding LabelWidth}" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                  IsEnabled="{Binding IsEditable}" HorizontalAlignment="Stretch" IsTextSearchEnabled="True" />
        <!-- Jump to the club / nation / league this points at. -->
        <Button Grid.Column="2" Classes="icon ghost" Margin="4,0,0,0" Command="{Binding OpenCommand}"
                IsVisible="{Binding ShowOpen}" ToolTip.Tip="{Binding OpenTip}">
          <c:Icon Kind="open" Size="15" />
        </Button>
      </Grid>
    </DataTemplate>

    <!-- Tabs: a group of fields… -->
    <DataTemplate DataType="vm:PropertyGroupViewModel">
      <ScrollViewer Padding="8,8,12,8">
        <Panel>
          <!-- Attribute groups sit two to a row; other groups one per row. -->
          <ItemsControl ItemsSource="{Binding Editors}" IsVisible="{Binding IsAttributeGrid}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemWidth="222" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Editors}" IsVisible="{Binding !IsAttributeGrid}" />
        </Panel>
      </ScrollViewer>
    </DataTemplate>

    <!-- …or who points here (a club's players), each row opening that entity. -->
    <DataTemplate DataType="vm:RelatedListViewModel">
      <DockPanel Margin="8,8,12,8">
        <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" Margin="4,0,0,8" Text="{Binding Summary}" />
        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="4,8" IsVisible="{Binding IsEmpty}" Text="Nobody here yet." />
        <ListBox x:Name="RelatedList" Classes="related" ItemsSource="{Binding Items}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:RelatedItem">
              <Button Classes="ghost related" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Command="{Binding $parent[ListBox].((vm:RelatedListViewModel)DataContext).OpenCommand}"
                      CommandParameter="{Binding}" ToolTip.Tip="{Binding Name, StringFormat='Open {0}'}" ToolTip.ShowDelay="700">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="30" Height="30" Margin="0,0,12,0" CornerRadius="15" ClipToBounds="True"
                          Background="{DynamicResource FieldBrush}"
                          IsVisible="{ReflectionBinding Images[pic], Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Image Source="{ReflectionBinding Images[pic]}" Stretch="UniformToFill"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="pill" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasBadge}">
                    <TextBlock Text="{Binding Badge}" Classes="num" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:ReadOnlyEditorViewModel">
      <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="label muted" Text="{Binding Label}" Width="{Binding LabelWidth}" />
        <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <!-- Header: who this is, with their face or badge when the user's packs have one -->
    <Panel DockPanel.Dock="Top">
      <!-- The tint fills the whole header, however tall its text gets, and fades out at the bottom. -->
      <Border Background="{DynamicResource ChromaBrush}" Opacity="0.16">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FFFFFFFF" />
            <GradientStop Offset="0.55" Color="#B0FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,18,18,8">
        <Border Width="84" Height="84" Margin="0,0,16,0" VerticalAlignment="Top"
                IsVisible="{Binding Picture.HasImage}"
                BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1"
                Background="{DynamicResource GlassInsetBrush}"
                BoxShadow="{DynamicResource GlassShadow}"
                Classes.round="{Binding Picture.IsPerson}" Classes.badge="{Binding !Picture.IsPerson}" ClipToBounds="True">
          <Image Source="{Binding Picture.Image}" RenderOptions.BitmapInterpolationMode="HighQuality"
                 Classes.fill="{Binding Picture.IsPerson}" Classes.fit="{Binding !Picture.IsPerson}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
          <Border Classes="pill" HorizontalAlignment="Left" Margin="0,4,0,0"
                  IsVisible="{Binding WatchState, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="6" TextElement.Foreground="{DynamicResource AccentBrush}">
              <Panel>
                <c:Icon Kind="snow" Size="13" IsVisible="{Binding IsFrozen}" />
                <c:Icon Kind="up" Size="13" IsVisible="{Binding IsOnlyUp}" />
              </Panel>
              <TextBlock Text="{Binding WatchState}" FontSize="12" FontWeight="Medium" />
            </StackPanel>
          </Border>
          <TextBlock Classes="muted" FontSize="11" Text="{Binding UnsupportedText}"
                     IsVisible="{Binding UnsupportedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <SelectableTextBlock FontSize="10.5" Classes="num" Foreground="{DynamicResource FaintBrush}" Text="{Binding AddressText}"
                               IsVisible="{Binding AddressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <!-- Actions on this record -->
        <Button x:Name="TransferButton" Grid.Column="2" Classes="accent" VerticalAlignment="Top" Margin="12,0,0,0"
                Command="{Binding TransferCommand}" IsVisible="{Binding CanTransfer}" ToolTip.Tip="Move to another club">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Kind="transfer" Size="15" />
            <TextBlock Text="Transfer" />
          </StackPanel>
        </Button>
      </Grid>
    </Panel>
    <!-- Content comes from the tab DataTemplates above (field group or related list). -->
    <TabControl x:Name="Tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedGroup}" Padding="10,0">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:EditorTabViewModel">
          <TextBlock Text="{Binding Name}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
    </TabControl>
  </DockPanel>
</UserControl>
