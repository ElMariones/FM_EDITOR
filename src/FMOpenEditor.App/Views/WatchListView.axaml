<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FMOpenEditor.App.ViewModels"
             x:Class="FMOpenEditor.App.Views.WatchListView"
             x:DataType="vm:WatchListViewModel"
             x:Name="Root">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Classes="h1" Text="Watch list" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Frozen attributes are restored whenever the game changes them. Only-up keeps improvements and undoes declines. Checked every 2 seconds while connected. Add people with a right-click in any list." />
      </StackPanel>
      <Button Grid.Column="1" Content="Remove all" Command="{Binding ClearCommand}" VerticalAlignment="Top" />
    </Grid>
    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:WatchedEntity">
          <Border Classes="card" Padding="12,8" Margin="0,0,0,6">
            <Grid ColumnDefinitions="*,140,140,Auto">
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Mode}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} attributes'}" Classes="muted" VerticalAlignment="Center" />
              <Button Grid.Column="3" Content="Remove" Command="{Binding #Root.((vm:WatchListViewModel)DataContext).RemoveCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</UserControl>
