<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FMOpenEditor.App.ViewModels"
             xmlns:c="using:FMOpenEditor.App.Controls"
             x:Class="FMOpenEditor.App.Views.SettingsPanel"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Spacing="16" Margin="6">

    <StackPanel Spacing="8">
      <TextBlock Classes="eyebrow" Text="APPEARANCE" />
      <ListBox SelectedIndex="{Binding ThemeIndex}" Background="Transparent">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBoxItem HorizontalContentAlignment="Center" ToolTip.Tip="Follow Windows">
          <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Kind="settings" Size="15" /><TextBlock Text="System" /></StackPanel>
        </ListBoxItem>
        <ListBoxItem HorizontalContentAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Kind="sun" Size="15" /><TextBlock Text="Day" /></StackPanel>
        </ListBoxItem>
        <ListBoxItem HorizontalContentAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Kind="moon" Size="15" /><TextBlock Text="Night" /></StackPanel>
        </ListBoxItem>
      </ListBox>
      <ToggleSwitch IsChecked="{Binding ReduceMotion}" OnContent="Reduce motion" OffContent="Reduce motion"
                    ToolTip.Tip="Stops the drifting background, page entrances and the mascot's blinking" />
    </StackPanel>

    <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" />

    <StackPanel Spacing="8">
      <TextBlock Classes="eyebrow" Text="CURRENCY" />
      <Grid ColumnDefinitions="*,Auto">
        <ListBox x:Name="CommonCurrencies" ItemsSource="{Binding CommonCurrencies}" SelectedItem="{Binding SelectedCommon}" Background="Transparent">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CurrencyOption">
              <TextBlock Text="{Binding Short}" ToolTip.Tip="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Command="{Binding ToggleMoreCurrenciesCommand}"
                Content="{Binding MoreCurrenciesLabel}" ToolTip.Tip="Search every currency in your save" />
      </Grid>

      <StackPanel Spacing="6" IsVisible="{Binding ShowMoreCurrencies}">
        <TextBox Classes="search" Watermark="Search currencies" Text="{Binding CurrencySearch}" />
        <ListBox x:Name="AllCurrencies" ItemsSource="{Binding CurrencyResults}" SelectedItem="{Binding SelectedOther}"
                 MaxHeight="190" Background="Transparent" IsVisible="{Binding CurrencyResults.Count}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CurrencyOption">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Mark}" Margin="10,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding CurrencyHint}"
                   IsVisible="{Binding CurrencyHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding CurrencySummary}" />
    </StackPanel>

    <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" />

    <StackPanel Spacing="8">
      <TextBlock Classes="eyebrow" Text="FACES AND BADGES" />
      <ToggleSwitch IsChecked="{Binding ShowPictures}" OnContent="Show pictures from my graphics packs" OffContent="Show pictures from my graphics packs" />
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                 Text="Faces, club badges, competition logos and flags are read from your Football Manager graphics folder, the same packs the game uses. Anything without a picture just shows its name." />

      <Border Classes="inset" Padding="12,10">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <c:Icon Kind="folder" Size="14" />
            <TextBlock Text="Graphics folder" FontWeight="SemiBold" FontSize="12.5" />
          </StackPanel>
          <SelectableTextBlock Text="{Binding FolderSummary}" Classes="muted num" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LibrarySummary}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <WrapPanel>
        <Button Click="OnBrowse" Margin="0,0,6,6">
          <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Kind="folder" Size="14" /><TextBlock Text="Choose folder…" /></StackPanel>
        </Button>
        <Button Command="{Binding UseDetectedFolderCommand}" IsVisible="{Binding HasCustomFolder}" Margin="0,0,6,6"
                Content="Find automatically" />
        <Button Command="{Binding RescanCommand}" Margin="0,0,6,6" ToolTip.Tip="Read the packs again after installing new ones">
          <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Kind="refresh" Size="14" /><TextBlock Text="Rescan" /></StackPanel>
        </Button>
      </WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
